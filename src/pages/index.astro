---
import '@/styles/global.css';
import { Separator } from '@/components/ui/separator';
import { Timeline } from '@/components/Timeline';
import { Cheatsheet } from '@/components/Cheatsheet';
import { Scenarios } from '@/components/Scenarios';
import { hreFastCastle } from '@/lib/mock-data';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>BuildOrders</title>
	</head>
	<body>
		<div class="mx-auto max-w-4xl space-y-8 px-4 py-8">
			<header class="space-y-1">
				<h1 class="text-3xl font-bold tracking-tight">BuildOrders</h1>
				<p class="text-muted-foreground">
					AoE4 build order analyzer — {hreFastCastle.civ} · {hreFastCastle.type}
				</p>
			</header>

			<section class="space-y-4">
				<h2 class="text-xl font-semibold">Timeline</h2>
				<Timeline client:load buildOrder={hreFastCastle} />
			</section>

			<Separator />

			<section class="space-y-4">
				<h2 class="text-xl font-semibold">Cheatsheet</h2>
				<Cheatsheet client:load buildOrder={hreFastCastle} />
			</section>

			<Separator />

			<section class="space-y-4">
				<h2 class="text-xl font-semibold">Scénarios</h2>
				<Scenarios client:load />
			</section>
		</div>
	</body>
</html>
