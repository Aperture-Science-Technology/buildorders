---
import '@/styles/global.css';
import { BuildOrderView } from '@/components/BuildOrderView';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>BuildOrders</title>
	</head>
	<body>
		<div class="mx-auto max-w-4xl space-y-8 px-4 py-8">
			<header class="space-y-1">
				<h1 class="text-3xl font-bold tracking-tight">BuildOrders</h1>
				<p class="text-muted-foreground">AoE4 build order analyzer</p>
			</header>

			<BuildOrderView client:load />
		</div>
	</body>
</html>
